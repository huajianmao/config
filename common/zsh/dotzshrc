export ZSH=$HOME/.oh-my-zsh
ZSH_THEME="hjmao"
DISABLE_AUTO_UPDATE="true"
DISABLE_UNTRACKED_FILES_DIRTY="true"
plugins=(autojump git zsh-autosuggestions zsh-syntax-highlighting zsh-completions)
autoload -U compinit && compinit
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=255,bg=236'
source $ZSH/oh-my-zsh.sh

export EDITOR=vim
export TERM=xterm-256color
export COLORTERM=truecolor
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
unsetopt nomatch
umask 022

alias vim="nvim"

# . "$HOME/.local/bin/env"
export NODE_HOME=/opt/node/current
export NEOVIM_HOME=/opt/neovim/current
export BLENDER_HOME=/opt/blender/current
export PATH=$BLENDER_HOME:$NODE_HOME/bin:$NEOVIM_HOME/bin:$PATH
export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
export VIRTUAL_ENV_DISABLE_PROMPT=1
[ -f ~/workspace/config/common/uvenv ] && source ~/workspace/config/common/uvenv

export HOMEBREW_API_DOMAIN="https://mirrors.aliyun.com/homebrew-bottles/api"
export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.aliyun.com/homebrew/homebrew-bottles"
export UV_DEFAULT_INDEX=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
export RUSTUP_DIST_SERVER=https://repo.huaweicloud.com/rustup
export RUSTUP_UPDATE_ROOT=https://repo.huaweicloud.com/rustup/rustup

alias pbcopy='xclip -selection clipboard'
alias pbpaste='xclip -selection clipboard -o'

SECRETS_FILE=~/.secrets.zsh
if [[ -f $SECRETS_FILE && -r $SECRETS_FILE ]]; then
  source "$SECRETS_FILE"
fi

ARKCLI_ZSH=~/workspace/config/gpt/arkcli/arkcli.zsh
[ -f $ARKCLI_ZSH ] && source $ARKCLI_ZSH
